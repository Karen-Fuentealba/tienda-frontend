name: Deploy Frontend to EC2

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build-and-deploy:

        with:
          ssh-private-key: ${{ secrets.EC2_SSH_KEY }}

      - name: Add EC2 host to known_hosts
        run: |
          mkdir -p ~/.ssh
          ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts

      - name: Copy project files to EC2
        run: |
          rsync -avz --delete ./frontend ubuntu@${{ secrets.EC2_HOST }}:~/tienda-perritos-frontend/

        run: |
          ssh ubuntu@${{ secrets.EC2_HOST }} << 'EOF'
          cd ~/tienda-perritos-frontend/frontend

          sudo docker build --no-cache -t tienda-perritos-frontend .

          sudo docker rm -f frontend || true

          sudo docker run -d --name frontend -p 80:80 tienda-perritos-frontend

          sudo docker ps -a
          EOF
